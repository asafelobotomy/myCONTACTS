{
  "name": "mycontacts",
  "version": "0.2.0",
  "description": "Local-first browser extension to extract, store, and export contacts from websites you open.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/asafelobotomy/myCONTACTS.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run && node --test scripts/lib/*.test.mjs",
    "test:watch": "vitest",
    "lint": "tsc -b --noEmit",
    "dev:update": "node scripts/mycontacts-dev.mjs update --launch",
    "dev:build": "node scripts/mycontacts-dev.mjs build",
    "dev:reload": "node scripts/mycontacts-dev.mjs reload",
    "dev:chrome": "node scripts/mycontacts-dev.mjs launch",
    "dev:status": "node scripts/mycontacts-dev.mjs status"
  },
  "dependencies": {
    "libphonenumber-js": "^1.12.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vcard4": "^4.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.31",
    "@types/chrome": "^0.0.323",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
